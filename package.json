{
  "name": "mmaitland-portfolio",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence-forward portfolio and case studies for www.mmaitland.dev - Next.js, MDX, Prisma, optional admin and auth.",
  "engines": {
    "node": ">=20.19.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mmaitland300/mmaitland-portfolio.git"
  },
  "overrides": {
    "express-rate-limit": "8.5.2",
    "ip-address": "10.2.0",
    "js-yaml": "5.2.0",
    "minimatch@10.2.4": {
      "brace-expansion": "5.0.6"
    },
    "postcss": "8.5.16"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "db:migrate:deploy": "prisma migrate deploy",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "resume:pdf": "node scripts/generate-resume-pdf.mjs",
    "favicon:generate": "node scripts/generate-favicon.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@base-ui/react": "^1.6.0",
    "@prisma/client": "^6.19.3",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.0",
    "lucide-react": "^0.577.0",
    "next": "16.2.9",
    "next-auth": "5.0.0-beta.31",
    "next-mdx-remote": "^6.0.0",
    "prisma": "^6.19.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "reading-time": "^1.5.0",
    "rehype-pretty-code": "^0.14.3",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.16.0",
    "shiki": "^4.3.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/mdx": "^2.0.14",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "playwright": "^1.61.1",
    "shadcn": "^4.12.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^5",
    "vitest": "^3.2.6"
  }
}
